/* Shared rofi popup (clipboard, power menu). Colours from pywal: ~/.cache/wal/colors-rofi-clip.rasi
   Wayland rofi has no click-outside-to-close, so the window covers the whole screen (dimmed backdrop)
   and the scripts bind a click on the backdrop to cancel. Position the panel with the pad-* boxes. */
@import "~/.cache/wal/colors-rofi-clip.rasi"

* {
    font: "JetBrainsMono Nerd Font 11";
    background-color: transparent;
    text-color: @fg;
}
window {
    width: 100%;
    height: 100%;
    location: center;
    anchor: center;
    background-color: #00000059;
    padding: 56px 8px 8px 8px;      /* top: just under waybar */
    children: [ row ];
}
row      { orientation: horizontal; children: [ pad-left, column, pad-right ]; }
pad-left, pad-right { expand: true; }
column   { orientation: vertical; expand: false; width: 460px; children: [ mainbox, pad-bottom ]; }
pad-bottom { expand: true; }
mainbox {
    expand: false;
    spacing: 10px;
    children: [ inputbar, listview, message ];
    background-color: @bg;
    border: 1px;
    border-color: @accent;
    border-radius: 16px;
    padding: 12px;
}
inputbar {
    background-color: @bg-alt;
    border-radius: 10px;
    padding: 8px 12px;
    spacing: 10px;
    children: [ prompt, entry ];
}
prompt { text-color: @accent; }
entry { placeholder: "Search clipboard…"; placeholder-color: @fg-dim; cursor: text; }
listview { lines: 9; fixed-height: true; scrollbar: false; spacing: 2px; }
element { padding: 7px 10px; border-radius: 8px; cursor: pointer; }
element normal.normal, element alternate.normal { background-color: transparent; }
element selected.normal { background-color: @accent; text-color: @bg; }
element-text { cursor: inherit; text-color: inherit; }
message { background-color: transparent; }
textbox { text-color: @fg-dim; horizontal-align: 0.5; font: "JetBrainsMono Nerd Font 9"; }
